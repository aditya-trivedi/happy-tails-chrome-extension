{
  "manifest_version": 3,
  "name": "Pawsome",
  "version": "3.0.0",
  "description": "A little dog or cat companion that lives at the bottom of every webpage.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Pawsome",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["pawsome-pets.js", "pawsome-engine.js", "content.js"],
      "css": ["pawsome.css"],
      "run_at": "document_idle"
    }
  ]
}
